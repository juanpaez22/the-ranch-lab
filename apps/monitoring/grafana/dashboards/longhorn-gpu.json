{
  "id": null,
  "uid": "ranch-longhorn-gpu",
  "title": "Ranch / Longhorn GPU",
  "description": "Longhorn GPU load, power, temperature, VRAM, and clocks from the WSL NVIDIA exporter. Unavailable series are not replaced with healthy zeroes.",
  "tags": [
    "ranch-lab",
    "repository-managed",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 0,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU utilization",
      "description": "Current aggregate GPU utilization reported through WSL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nvidia_smi_utilization_gpu_ratio{job=\"nvidia-gpu-exporter\"} * 100",
          "legendFormat": "Longhorn",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
