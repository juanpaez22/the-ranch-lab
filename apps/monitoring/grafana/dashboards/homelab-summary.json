          "titleSize": 18,
          "valueSize": 26
        }
      }
    },
    {
      "id": 7,
      "title": "Linux thermals",
      "type": "timeseries",
      "description": "CPU package temperatures from the two k3s laptops. Guide lines are attention thresholds, not measured throttling limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by(node) (node_hwmon_temp_celsius{job=\"node-exporter\"} and on(instance,chip,sensor) node_hwmon_sensor_label{job=\"node-exporter\",label=~\"Package id.*|Tctl|Tdie\"})",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "noValue": "NO TELEMETRY",
          "min": 0,
          "max": 105,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
