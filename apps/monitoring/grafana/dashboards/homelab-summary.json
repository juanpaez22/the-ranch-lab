    {
      "id": 6,
      "title": "Linux storage headroom",
      "type": "bargauge",
      "description": "Available percentage on the root filesystem of each k3s node. Local-path application data consumes these same node filesystems.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
