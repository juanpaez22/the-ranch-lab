{
  "id": null,
  "uid": "ranch-homelab-summary",
  "title": "Ranch / Operations",
  "description": "Always-on homelab homepage: fleet and Kubernetes health first, one resource quadrant per machine, then storage and thermal detail. Cyan = Bronco, violet = Yeti, orange = Longhorn. Missing telemetry is never converted to a healthy zero.",
  "tags": [
    "ranch-lab",
    "repository-managed",
    "wallboard"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 0,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Machines",
      "type": "stat",
      "description": "Bronco and Yeti require both a healthy Node Exporter scrape and Kubernetes Ready state. Longhorn represents its external GPU telemetry path, so it can be unavailable during sleep, restart, or deliberate workstation downtime.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by(node) (((up{job=\"node-exporter\"} or on(node) (0 * kube_node_info{job=\"kube-state-metrics\"})) * on(node) kube_node_status_condition{job=\"kube-state-metrics\",condition=\"Ready\",status=\"true\"}) and on() (up{job=\"kube-state-metrics\"} == 1)) or up{job=\"nvidia-gpu-exporter\",node=\"longhorn\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CHECK",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 16,
          "valueSize": 38
        },
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Kubernetes",
      "type": "stat",
      "description": "All values should be zero. Missing KSM data produces NO TELEMETRY rather than a healthy zero. Replica state does not prove end-to-end service availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(2 - sum(kube_node_status_condition{job=\"kube-state-metrics\",condition=\"Ready\",status=\"true\"})) and on() (up{job=\"kube-state-metrics\"} == 1)",
          "legendFormat": "Nodes not ready",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(clamp_min(kube_deployment_spec_replicas{job=\"kube-state-metrics\"} - kube_deployment_status_replicas_available{job=\"kube-state-metrics\"}, 0)) + sum(clamp_min(kube_daemonset_status_desired_number_scheduled{job=\"kube-state-metrics\"} - kube_daemonset_status_number_available{job=\"kube-state-metrics\"}, 0))) and on() (up{job=\"kube-state-metrics\"} == 1)",
          "legendFormat": "Missing replicas",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{job=\"kube-state-metrics\"}[1h])) and on() (up{job=\"kube-state-metrics\"} == 1)",
          "legendFormat": "Restarts / 1h",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 15,
          "valueSize": 34
        },
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "Bronco / resources",
      "type": "timeseries",
      "description": "Five-minute CPU utilization and memory pressure on the k3s server.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",node=\"bronco\",mode=\"idle\"}[5m])))",
          "legendFormat": "CPU",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\",node=\"bronco\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",node=\"bronco\"})",
          "legendFormat": "Memory",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "NO TELEMETRY",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "#56D4DD"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
