{
  "id": null,
  "uid": "ranch-homelab-summary",
  "title": "Ranch / Operations",
  "description": "Always-on overview: health first, resource trends second, disk/LAN/thermals last. Cyan = Bronco, violet = Yeti in trend panels. Unknown telemetry is never converted to a healthy zero. Workload state is not an end-to-end service check.",
  "tags": [
    "ranch-lab",
    "repository-managed",
    "wallboard"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 0,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Nodes ready + reachable",
      "type": "stat",
      "description": "Ready requires a successful host scrape and Kubernetes Ready state. A missing host target is treated as unhealthy when KSM still knows the node. Missing/down KSM yields NO TELEMETRY, not a healthy zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by(node) (((up{job=\"node-exporter\"} or on(node) (0 * kube_node_info{job=\"kube-state-metrics\"})) * on(node) kube_node_status_condition{job=\"kube-state-metrics\",condition=\"Ready\",status=\"true\"}) and on() (up{job=\"kube-state-metrics\"} == 1))",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CHECK NODE",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 16,
          "valueSize": 42
        },
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Workload replica shortfall",
      "type": "stat",
      "description": "Missing available Deployment replicas plus missing available DaemonSet instances across the cluster. Zero means desired replicas are available; it does not prove application HTTP health. KSM must be reachable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(clamp_min(kube_deployment_spec_replicas{job=\"kube-state-metrics\"} - kube_deployment_status_replicas_available{job=\"kube-state-metrics\"}, 0)) + sum(clamp_min(kube_daemonset_status_desired_number_scheduled{job=\"kube-state-metrics\"} - kube_daemonset_status_number_available{job=\"kube-state-metrics\"}, 0))) and on() (up{job=\"kube-state-metrics\"} == 1)",
          "legendFormat": "Missing replicas",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ALL AVAILABLE",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 16,
          "valueSize": 32
        },
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "Container restarts / last hour",
      "type": "stat",
      "description": "Estimated counter increase over the last hour, across observed application containers. Rollout-created replacement pods are not themselves container restarts. Prometheus extrapolation can produce fractional estimates; displayed rounded. Missing KSM is unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{job=\"kube-state-metrics\"}[1h])) and on() (up{job=\"kube-state-metrics\"} == 1)",
          "legendFormat": "Restarts in 1h",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 16,
          "valueSize": 42
        },
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "CPU utilization",
      "type": "timeseries",
      "description": "Five-minute average busy CPU across cores. Cyan is Bronco; violet is Yeti. The legend shows latest and peak over the visible window. High utilization is activity, not automatically a failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by(node) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^bronco(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56D4DD"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^yeti(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B39DFF"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Memory used",
      "type": "timeseries",
      "description": "100 \u00d7 (1 \u2212 MemAvailable / MemTotal). Uses available memory, including reclaimable memory, rather than treating cache as unavailable. Rising baseline reveals sustained memory demand.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^bronco(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56D4DD"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^yeti(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B39DFF"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Root filesystem headroom",
      "type": "bargauge",
      "description": "Space available to non-root processes on /. Below 20% is an early warning; below 10% needs attention. This is the host filesystem, not a PVC quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "sizing": "auto",
        "minVizWidth": 0,
        "minVizHeight": 20,
        "maxVizHeight": 100,
        "namePlacement": "top",
        "text": {
          "titleSize": 18,
          "valueSize": 26
        }
      }
    },
    {
      "id": 7,
      "title": "Physical LAN traffic",
      "type": "timeseries",
      "description": "Five-minute RX/TX rates on physical Ethernet/Wi-Fi names only (en*, eth*, wl*). Excludes loopback, CNI, Flannel and veth to avoid counting the same traffic again. Solid = RX, dashed = TX. Current/peak are bytes per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(node) (rate(node_network_receive_bytes_total{job=\"node-exporter\",device=~\"en.*|eth.*|wl.*\"}[5m]))",
          "legendFormat": "{{node}} RX",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(node) (rate(node_network_transmit_bytes_total{job=\"node-exporter\",device=~\"en.*|eth.*|wl.*\"}[5m]))",
          "legendFormat": "{{node}} TX",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 0,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^bronco(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56D4DD"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^yeti(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B39DFF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* TX$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "CPU package temperature",
      "type": "timeseries",
      "description": "CPU-package sensor only (Package id / Tctl / Tdie), not the maximum of unrelated NVMe/Wi-Fi sensors. Guide lines at 75/90 \u00b0C are attention thresholds, not measured throttling limits. No additional exporter is needed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transparent": false,
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by(node) (node_hwmon_temp_celsius{job=\"node-exporter\"} and on(instance,chip,sensor) node_hwmon_sensor_label{job=\"node-exporter\",label=~\"Package id.*|Tctl|Tdie\"})",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "noValue": "NO TELEMETRY",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 105,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^bronco(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56D4DD"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^yeti(?: |$)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B39DFF"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
