{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-cpp/gemma-4-26b-a4b-q4",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 16000
    },
    "buffer": 16000
  },
  "providers": {
    "llama-cpp": {
      "name": "Local llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:19331/v1",
        "apiKey": "{file:~/.config/llama.cpp/api.key}",
        "headerTimeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "gemma-4-26b-a4b-q4": {
          "modelID": "gemma-4-26b-a4b-q4",
          "name": "[LOCAL] Gemma 4 26B-A4B Q4_0 128K",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "input": 122880,
            "output": 8192
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        },
        "gemma-4-e4b-q4": {
          "modelID": "gemma-4-e4b-q4",
