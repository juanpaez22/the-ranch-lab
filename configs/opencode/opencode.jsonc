{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-cpp/gemma-4-26b-a4b-q4",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 16000
    },
    "buffer": 16000
  },
  "providers": {
    "llama-cpp": {
      "name": "Local llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "gemma-4-26b-a4b-q4": {
          "modelID": "gemma-4-26b-a4b-q4",
          "name": "Gemma 4 26B-A4B Q4_0",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "input": 122880,
            "output": 8192
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        }
      }
    }
  }
}
